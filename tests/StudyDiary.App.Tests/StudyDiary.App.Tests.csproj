<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StudyDiary.App\StudyDiary.App.csproj" />
  </ItemGroup>

  <!-- One test clock for every test project: Data.Tests owns it and tests it. -->
  <ItemGroup>
    <Compile Include="..\StudyDiary.Data.Tests\ManualTimeProvider.cs" Link="ManualTimeProvider.cs" />
  </ItemGroup>

</Project>

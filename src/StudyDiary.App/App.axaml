<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StudyDiary.App.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the system's light or dark setting. -->

    <!-- The provisional look (ROADMAP 0.1.0): every colour lives here, and
         controls ask only for a role, such as Classes="accent". -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="DiaryBackground" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#F2F7FF" />
                        <GradientStop Offset="1" Color="#C9DCFF" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <LinearGradientBrush x:Key="DiaryBackground" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#0B1631" />
                        <GradientStop Offset="1" Color="#1E3A78" />
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#2563EB" />
                <ColorPaletteResources x:Key="Dark" Accent="#3B82F6" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource DiaryBackground}" />
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Application.Styles>
</Application>

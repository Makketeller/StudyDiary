<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:StudyDiary.App.ViewModels"
        xmlns:entries="using:StudyDiary.Domain.Entries"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="StudyDiary.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="StudyDiary.App">
    <Window.DataTemplates>
        <DataTemplate DataType="vm:OpeningViewModel">
            <StackPanel Margin="16" Spacing="12">
                <ProgressBar IsIndeterminate="True" />
                <TextBlock Text="Opening your diary…" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:PlaceholderViewModel">
            <ScrollViewer>
                <TextBlock Margin="16" Text="{Binding Text}" TextWrapping="Wrap" />
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="vm:DiaryViewModel">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16" Spacing="8">
                    <TextBox Text="{Binding NewTitle}" PlaceholderText="Title" />
                    <TextBox Text="{Binding NewBody}" PlaceholderText="Body"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
                    <Button Content="Add" IsEnabled="{Binding CanAddEntry}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Entries}">
                    <!-- the ListBox.ItemTemplate from before, unchanged -->
                </ListBox>
            </DockPanel>
        </DataTemplate>
    </Window.DataTemplates>

    <ContentControl Content="{Binding Current}" />
</Window>

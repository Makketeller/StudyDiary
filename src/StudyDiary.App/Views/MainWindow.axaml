<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:StudyDiary.App.ViewModels"
        xmlns:entries="using:StudyDiary.Domain.Entries"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="StudyDiary.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="StudyDiary.App">
    <Window.DataTemplates>
        <DataTemplate DataType="vm:OpeningViewModel">
            <StackPanel Margin="16" Spacing="12">
                <ProgressBar IsIndeterminate="True" />
                <TextBlock Text="Opening your diary…" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="vm:NewerViewModel">
            <ScrollViewer>
                <StackPanel Margin="16" Spacing="12">
                    <TextBlock TextWrapping="Wrap"
                               Text="Your diary was saved by a newer version of StudyDiary, so this version won't open it, and nothing has been changed. Update StudyDiary to open it." />
                    <Expander Header="Details">
                        <SelectableTextBlock Text="{Binding Details}" TextWrapping="Wrap" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="vm:DamagedViewModel">
            <ScrollViewer>
                <StackPanel Margin="16" Spacing="12">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    <Button Content="Open that copy" Command="{Binding OpenCopy}" Classes="accent"
                            IsVisible="{Binding HasCopy}" IsEnabled="{Binding CanOpenCopy}" />
                    <SelectableTextBlock Text="{Binding KeptAtMessage}" TextWrapping="Wrap"
                                         IsVisible="{Binding KeptAtMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Expander Header="Details for fixing the file by hand">
                        <SelectableTextBlock Text="{Binding Details}" TextWrapping="Wrap" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="vm:DiaryViewModel">
            <Panel>
                <DockPanel IsVisible="{Binding !IsReviewing}">
                    <StackPanel DockPanel.Dock="Top" Margin="16" Spacing="8">
                        <Button Content="Review" Command="{Binding StartReview}" Classes="accent" />
                        <TextBox Text="{Binding NewTitle}" PlaceholderText="Title" />
                        <TextBox Text="{Binding NewBody}" PlaceholderText="Body"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" />
                        <Button Content="Add" Command="{Binding AddEntry}" IsEnabled="{Binding CanAddEntry}" Classes="accent" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="16" Spacing="8">
                        <Button Content="Delete" Command="{Binding AskToDeleteEntry}"
                                IsEnabled="{Binding CanDeleteEntry}"
                                IsVisible="{Binding !IsConfirmingDelete}" />
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    IsVisible="{Binding IsConfirmingDelete}">
                            <TextBlock Text="Delete this entry? This can't be undone."
                                       VerticalAlignment="Center" />
                            <Button Content="Delete" Command="{Binding DeleteEntry}" />
                            <Button Content="Cancel" Command="{Binding CancelDelete}" />
                        </StackPanel>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="entries:Entry">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding CreatedOn, StringFormat='{}{0:yyyy-MM-dd}'}" />
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <ContentControl Content="{Binding Review}" />
            </Panel>
        </DataTemplate>

        <DataTemplate DataType="vm:ReviewViewModel">
            <ScrollViewer>
                <StackPanel Margin="16" Spacing="12">
                    <StackPanel Spacing="12" IsVisible="{Binding !IsSessionOver}">
                        <TextBlock Text="{Binding Prompt}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <Button Content="Reveal" Command="{Binding Reveal}"
                                IsVisible="{Binding !IsRevealed}" />
                        <StackPanel Spacing="12" IsVisible="{Binding IsRevealed}">
                            <TextBlock Text="{Binding Answer}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Pass" Command="{Binding Pass}" Classes="accent" />
                                <Button Content="Fail" Command="{Binding Fail}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="12" IsVisible="{Binding IsSessionOver}">
                        <TextBlock Text="Nothing is ready to review right now."
                                   IsVisible="{Binding !CanKeepGoing}" />
                        <Button Content="Keep going" Command="{Binding KeepGoing}" Classes="accent"
                                IsVisible="{Binding CanKeepGoing}" />
                    </StackPanel>

                    <Button Content="Done for now" Command="{Binding Finish}" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.DataTemplates>

    <ContentControl Content="{Binding Current}" />
</Window>
